DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fantasy_cricket?schema=public"
SPORTMONKS_BASE_URL="https://cricket.sportmonks.com/api/v2.0"
SPORTMONKS_API_TOKEN="your_sportmonks_token_here"
SPORTMONKS_HOURLY_LIMIT=3000
JWT_ACCESS_SECRET="change_me_access"
JWT_REFRESH_SECRET="change_me_refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=4000
# Only leagues your Sportmonks plan actually covers should appear here — used by
# the matches module to filter fixture listings to what you're licensed to show.
ALLOWED_SPORTMONKS_LEAGUE_IDS="3,5,6"

# Razorpay (payments) — from your Razorpay dashboard
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# RazorpayX (payouts, for approved withdrawals) — separate product/keys
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""

# One-time admin bootstrap — set, run `npm run prisma:seed`, then unset
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
